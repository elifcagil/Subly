<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.XIB" version="3.0" toolsVersion="22500" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES">
    <device id="retina6_12" orientation="portrait" appearance="light"/>
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="22500"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="System colors in document resources" minToolsVersion="11.0"/>
    </dependencies>
    <objects>
        <placeholder placeholderIdentifier="IBFilesOwner" id="-1" userLabel="File's Owner" customClass="PaywallPlanCard" customModule="Subly" customModuleProvider="target">
            <connections>
                <outlet property="titleLabel" destination="PPC-TTL-01" id="OUT-PPC-TTL"/>
                <outlet property="bestValueChip" destination="PPC-CHP-01" id="OUT-PPC-CHP"/>
                <outlet property="priceLabel" destination="PPC-PRC-01" id="OUT-PPC-PRC"/>
                <outlet property="perMonthLabel" destination="PPC-PMO-01" id="OUT-PPC-PMO"/>
                <outlet property="radioImageView" destination="PPC-RAD-01" id="OUT-PPC-RAD"/>
            </connections>
        </placeholder>
        <placeholder placeholderIdentifier="IBFirstResponder" id="-2" userLabel="First Responder" customClass="UIResponder"/>
        <view contentMode="scaleToFill" id="PPC-RTV-01" userLabel="Content">
            <rect key="frame" x="0.0" y="0.0" width="345" height="92"/>
            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
            <subviews>
                <stackView opaque="NO" contentMode="scaleToFill" axis="horizontal" alignment="center" spacing="12" translatesAutoresizingMaskIntoConstraints="NO" id="PPC-ROW-STK">
                    <subviews>
                        <stackView opaque="NO" contentMode="scaleToFill" axis="vertical" alignment="leading" spacing="4" translatesAutoresizingMaskIntoConstraints="NO" id="PPC-TXT-STK">
                            <subviews>
                                <stackView opaque="NO" contentMode="scaleToFill" axis="horizontal" alignment="center" spacing="8" translatesAutoresizingMaskIntoConstraints="NO" id="PPC-TTL-ROW">
                                    <subviews>
                                        <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Plan" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" adjustsFontForContentSizeCategory="YES" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="PPC-TTL-01">
                                            <fontDescription key="fontDescription" style="UICTFontTextStyleHeadline"/>
                                            <color key="textColor" name="TextPrimary"/>
                                            <nil key="highlightedColor"/>
                                        </label>
                                        <view contentMode="scaleToFill" hidden="YES" horizontalHuggingPriority="1000" verticalHuggingPriority="251" horizontalCompressionResistancePriority="1000" translatesAutoresizingMaskIntoConstraints="NO" id="PPC-CHP-01" customClass="SublyChip" customModule="Subly" customModuleProvider="target">
                                            <rect key="frame" x="0.0" y="0.0" width="60" height="20"/>
                                            <color key="backgroundColor" red="0.0" green="0.0" blue="0.0" alpha="0.0" colorSpace="custom" customColorSpace="sRGB"/>
                                        </view>
                                    </subviews>
                                </stackView>
                                <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="1000" verticalHuggingPriority="251" horizontalCompressionResistancePriority="1000" text="$0.00 / month" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" adjustsFontForContentSizeCategory="YES" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="PPC-PRC-01" customClass="SublyAmountLabel" customModule="Subly" customModuleProvider="target">
                                    <fontDescription key="fontDescription" style="UICTFontTextStyleHeadline"/>
                                    <color key="textColor" name="TextPrimary"/>
                                    <nil key="highlightedColor"/>
                                </label>
                                <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Per month" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" adjustsFontForContentSizeCategory="YES" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="PPC-PMO-01">
                                    <fontDescription key="fontDescription" style="UICTFontTextStyleFootnote"/>
                                    <color key="textColor" name="TextSecondary"/>
                                    <nil key="highlightedColor"/>
                                </label>
                            </subviews>
                        </stackView>
                        <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFit" horizontalHuggingPriority="1000" verticalHuggingPriority="251" image="circle" catalog="system" translatesAutoresizingMaskIntoConstraints="NO" id="PPC-RAD-01">
                            <color key="tintColor" name="TextTertiary"/>
                            <preferredSymbolConfiguration key="preferredSymbolConfiguration" textStyle="headline" scale="default"/>
                        </imageView>
                    </subviews>
                </stackView>
            </subviews>
            <color key="backgroundColor" name="Surface"/>
            <constraints>
                <constraint firstItem="PPC-ROW-STK" firstAttribute="top" secondItem="PPC-RTV-01" secondAttribute="top" constant="16" id="C-PPC-ROW-T"/>
                <constraint firstItem="PPC-ROW-STK" firstAttribute="leading" secondItem="PPC-RTV-01" secondAttribute="leading" constant="16" id="C-PPC-ROW-L"/>
                <constraint firstItem="PPC-RTV-01" firstAttribute="trailing" secondItem="PPC-ROW-STK" secondAttribute="trailing" constant="16" id="C-PPC-ROW-R"/>
                <constraint firstItem="PPC-RTV-01" firstAttribute="bottom" secondItem="PPC-ROW-STK" secondAttribute="bottom" constant="16" id="C-PPC-ROW-B"/>
            </constraints>
            <point key="canvasLocation" x="20" y="20"/>
